{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
          // "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3} {Username} {Message:lj}{Exception}{NewLine}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "hotelmanagementsqlconnectionstring": "data source=DESKTOP-S8CP3CH;integrated security=yes;Encrypt=True;TrustServerCertificate=True;initial catalog=hotelmanagement_UAT",
    "midlandsqlconnectionstring": "data source=DESKTOP-S8CP3CH;integrated security=yes;Encrypt=True;TrustServerCertificate=True;initial catalog=MIDLAND_UAT",
    "Northwind_DbConnectionString": "data source=DESKTOP-S8CP3CH;integrated security=yes;Encrypt=True;TrustServerCertificate=True;initial catalog=Northwind_DB_UAT",
    "Restaurant_DbConnectionString": "data source=DESKTOP-S8CP3CH;integrated security=yes;Encrypt=True;TrustServerCertificate=True;initial catalog=RestaurantDB_UAT"

  },
  "Jwt": { //To prepare the token the below key values information is required.
    "Key": "Yh2k7QSu4l8CZg5p6X3Pna9L0Miy4D3Bvt0JVr87UcOj69Kqw5R2Nmf4FWs03Hdx",
    "Issuer": "JWTAuthenticationServer",
    "Audience": "JWTServicePostmanClient",
    "Subject": "JWTServiceAccessToken",
    "TokenExpriyTime": 4
  },

  "AllowedHosts": "*"
}
